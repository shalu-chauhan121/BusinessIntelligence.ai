# ---------------------------------------------------------------------------
# Frontend configuration. Copy to `.env` (Vite only exposes VITE_* variables).
#
# Leave the Firebase values blank to run against the backend's demo login,
# which lets you use the whole product before creating a Firebase project.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
