# ---------------------------------------------------------------------------
# BusinessIntelligence.ai — backend configuration
# Copy to `.env` and fill in. Every value below has a working default, so the
# app boots and demos correctly even with an empty file.
# ---------------------------------------------------------------------------

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# json  = local file-backed, Mongo-shaped document store (zero install)
# mongo = MongoDB / MongoDB Atlas (set MONGODB_URI below)
DB_BACKEND=json
DATA_DIR=./data
MONGODB_URI=
MONGODB_DB=businessintelligence

# --- Firebase authentication ----------------------------------------------
# Project id from the Firebase console (Project settings -> General).
FIREBASE_PROJECT_ID=
# EITHER point at a downloaded service-account json ...
GOOGLE_APPLICATION_CREDENTIALS=
# ... OR paste the whole service-account json as one line here.
FIREBASE_SERVICE_ACCOUNT_JSON=

# AUTH_MODE=firebase : ID tokens are cryptographically verified (production)
# AUTH_MODE=demo     : tokens are accepted and decoded without signature check,
#                      and a local demo login endpoint is enabled. Use this to
#                      run the project before Firebase credentials exist.
# AUTH_MODE=auto     : firebase when credentials are present, demo otherwise.
AUTH_MODE=auto

# --- LLM reasoning layer ---------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to run the deterministic fallback reasoner.
# The four-stage pipeline produces a complete investigation either way.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=90

# --- Analysis tuning -------------------------------------------------------
# |robust z| above this marks a KPI change as a meaningful signal
ANOMALY_Z_THRESHOLD=2.0
# changes smaller than this (%) are never called meaningful, whatever the z
MIN_MATERIAL_CHANGE_PCT=3.0
# how many drivers per dimension the Observe stage passes downstream
MAX_DRIVERS_PER_DIMENSION=5
